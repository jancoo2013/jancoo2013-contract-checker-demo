FROM python:3.12.11-slim-bookworm AS llama-build
ARG LLAMA_CPP_REVISION=a30273376ef669023334fc20ad02ae4ed8196a65
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake curl g++ make \
 && rm -rf /var/lib/apt/lists/* && mkdir -p /src/llama.cpp \
 && curl -fsSL --retry 3 "https://github.com/ggml-org/llama.cpp/archive/${LLAMA_CPP_REVISION}.tar.gz" -o /tmp/llama.tgz \
 && tar -xzf /tmp/llama.tgz --strip-components=1 -C /src/llama.cpp \
 && cmake -S /src/llama.cpp -B /src/llama.cpp/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF -DGGML_CUDA=OFF -DLLAMA_CURL=OFF \
 && cmake --build /src/llama.cpp/build --target llama-server --parallel 8

FROM python:3.12.11-slim-bookworm AS model-fetch
ARG SURYA_MODEL_REVISION=6a3a4c30e5e74446d4f8b6afd05b2f2da970f470
ARG SURYA_MODEL_SHA256=1f18abe17b1ed8b4e47ee9b1ad0e274c93daf5efbb6b29a04ff1712e37051e05
ARG SURYA_MMPROJ_SHA256=98c0563673b1657ff6d021d1e5f04af06cbf61bb40c63ac613e8bb71b42fb2c0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /models \
 && curl -fsSL --retry 3 "https://huggingface.co/datalab-to/surya-ocr-2-gguf/resolve/${SURYA_MODEL_REVISION}/surya-2.gguf" -o /models/surya-2.gguf \
 && curl -fsSL --retry 3 "https://huggingface.co/datalab-to/surya-ocr-2-gguf/resolve/${SURYA_MODEL_REVISION}/surya-2-mmproj.gguf" -o /models/surya-2-mmproj.gguf \
 && echo "${SURYA_MODEL_SHA256}  /models/surya-2.gguf" | sha256sum -c - \
 && echo "${SURYA_MMPROJ_SHA256}  /models/surya-2-mmproj.gguf" | sha256sum -c -

FROM python:3.12.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
 SURYA_INFERENCE_BACKEND=llamacpp SURYA_INFERENCE_URL=http://127.0.0.1:8081/v1 SURYA_INFERENCE_PARALLEL=4 SURYA_INFERENCE_AUTOSTART=0 PORT=8080
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/* \
 && python -m pip install --no-cache-dir "surya-ocr==0.22.1" \
 && groupadd --system benchmark && useradd --system --gid benchmark --home-dir /tmp/benchmark --shell /usr/sbin/nologin benchmark \
 && mkdir -p /app/research/ocr_benchmark /tmp/benchmark && chown -R benchmark:benchmark /app /tmp/benchmark
COPY --from=llama-build /src/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=model-fetch /models/ /opt/surya/
COPY --chown=benchmark:benchmark research/ocr_benchmark/benchmark.py research/ocr_benchmark/surya_targeted_region_benchmark.py research/ocr_benchmark/surya_targeted_cloud_run_server.py research/ocr_benchmark/surya_targeted_cloud_run_entrypoint.sh /app/research/ocr_benchmark/
USER benchmark
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "/app/research/ocr_benchmark/surya_targeted_cloud_run_entrypoint.sh"]
