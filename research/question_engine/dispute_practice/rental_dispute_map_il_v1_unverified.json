      "pre_signing_fit": "NO_FUTURE_DISPUTE_MODE"
    },
    {
      "id": "q09_notice",
      "trigger": "a disputed notice was already sent",
      "question": "Каким способом, когда и на какой адрес направлялось уведомление; сохранилось ли подтверждение отправки?",
      "changes": ["effective_notice_date", "cure_period", "procedural_deadline"],
      "pre_signing_fit": "NO_FUTURE_DISPUTE_MODE"
    },
    {
      "id": "q10_arnona",
      "trigger": "utility/arnona debt already disputed",
      "question": "Есть ли подтверждение смены держателя и оплаченные счета с показаниями на дату передачи?",
      "changes": ["period_allocation", "reimbursement", "security_deduction"],
      "pre_signing_fit": "NO_UNIVERSAL_REMINDER_OR_FUTURE_DISPUTE_MODE"
    },
    {
      "id": "q11_sublet",
      "trigger": "replacement tenant has already been proposed",
      "question": "Был ли предложен конкретный новый жилец и ответил ли арендодатель письменно с причинами?",
      "changes": ["reasonableness_of_refusal", "breach", "mitigation"],
      "pre_signing_fit": "NO_FUTURE_DISPUTE_MODE"
    },
    {
      "id": "q12_third_payer",
      "trigger": "third-party payment clause is ambiguous in the signed package",
