  "cross_cutting_patterns": [
    {
      "id": "x01_no_self_help",
      "pattern": "A contractual right to cancel or demand vacancy is distinct from physical eviction.",
      "case_ids": ["case_tavorov"]
    },
    {
      "id": "x02_proof_and_chronology",
      "pattern": "Many outcomes turn on dated chronology: demand, cure, payment, defect, handover, key return, presentation, and service.",
      "case_ids": ["case_hazan", "case_habani", "case_gabai"]
    },
    {
      "id": "x03_no_double_recovery",
      "pattern": "Rent, holdover sums, interest, security realization, and actual damages must be mapped by date and head to detect overlap.",
      "case_ids": ["case_gabai", "case_pi_glilot"]
    },
    {
      "id": "x04_mandatory_rules",
      "pattern": "Contract wording must be analyzed separately from mandatory residential-lease protections and applicability gates.",
      "case_ids": ["case_hazan"]
    },
    {
      "id": "x05_security_layers",
      "pattern": "Separate bank/instrument processing, authority to complete or present, underlying debt, and execution/opposition procedure.",
      "case_ids": ["case_hazan", "case_aburumi", "case_habani"]
    }
  ],
  "question_engine_candidates": [
    {
      "id": "q01_term",
      "trigger": "term, option, early-exit, or holdover analysis",
      "question": "Есть ли подписанное уточнение, переписка или чеки, показывающие 12 или 24 месяца?",
      "changes": ["end_date", "rent_period", "option_window", "holdover_start"],
      "pre_signing_fit": "CONDITIONAL"
    },
    {
      "id": "q02_option",
      "trigger": "additional-year option is relevant",
      "question": "Есть ли письменное уточнение условий опции и согласия арендодателя?",
